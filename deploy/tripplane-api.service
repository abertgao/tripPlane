[Unit]
Description=Shanhe Journal private API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/tripPlane
Environment=NODE_ENV=production
EnvironmentFile=/etc/tripplane/api.env
ExecStart=/home/ubuntu/.nvm/versions/node/v22.22.3/bin/node server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/tripplane
UMask=0077
MemoryMax=512M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

[Unit]
Description=tripPlane published site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/tripPlane
ExecStart=/home/ubuntu/.nvm/versions/node/v22.22.3/bin/node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 8812 --strictPort
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
